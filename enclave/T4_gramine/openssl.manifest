[loader]
entrypoint.uri = "file:{{ gramine.libos }}"
log_level = "error"
insecure__use_cmdline_argv = true

[libos]
entrypoint = "/usr/bin/openssl"

[loader.env]
LD_LIBRARY_PATH = "/lib:/lib64:/usr/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/lib"
uri = "file:/lib"

[[fs.mounts]]
path = "/lib64"
uri = "file:/lib64"

[[fs.mounts]]
path = "/usr/lib/x86_64-linux-gnu"
uri = "file:/usr/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/etc/ssl"
uri = "file:/etc/ssl"

[[fs.mounts]]
path = "/usr/bin/openssl"
uri = "file:/usr/bin/openssl"

[[fs.mounts]]
path = "/usr/bin"
uri = "file:/usr/bin"

[sgx]
debug = true
enclave_size = "256M"
max_threads = 4

[[sgx.trusted_files]]
uri = "file:{{ gramine.runtimedir() }}/"

[[sgx.trusted_files]]
uri = "file:/lib64/"

[[sgx.trusted_files]]
uri = "file:/usr/lib/x86_64-linux-gnu/"

[[sgx.trusted_files]]
uri = "file:/usr/lib/x86_64-linux-gnu/ossl-modules/"

[[sgx.trusted_files]]
uri = "file:/etc/ssl/"

[[sgx.trusted_files]]
uri = "file:/usr/bin/openssl"
