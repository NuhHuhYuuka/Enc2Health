[loader]
entrypoint.uri = "file:{{ gramine.libos }}"
log_level = "error"
insecure__use_cmdline_argv = true

[libos]
entrypoint = "/duckdb_real"

[loader.env]
LD_LIBRARY_PATH = "/lib:/lib64:/usr/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/lib"
uri = "file:{{ gramine.runtimedir() }}"

[[fs.mounts]]
path = "/lib64"
uri = "file:/lib64"

[[fs.mounts]]
path = "/usr/lib/x86_64-linux-gnu"
uri = "file:/usr/lib/x86_64-linux-gnu"

[[fs.mounts]]
path = "/duckdb_real"
uri = "file:/home/lan/Y_TE/T1_gramine/duckdb_real"

# NOTE: This manifest is for gramine-direct (simulation) runs.
# It intentionally omits the [sgx] section and any sgx.* keys
# which are only applicable for real SGX hardware manifests.
